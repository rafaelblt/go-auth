# A template of go-auth's configuration, for reference only.
#
# go-auth does not read this file, or any .env file: its settings come from the
# process environment alone. Copy these variables into wherever your deployment
# sets environment variables; the development stack sets its own in
# docker-compose.dev.yml. What each one means, and the rules for its value, are
# in docs/configuration.md.

# Required.

DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# host:port to listen on; 0.0.0.0 inside a container.
ADDRESS=0.0.0.0:8080

# Optional. Each one is shown with its default.

# true applies the pending migrations at startup; false only checks, and the
# service does not start until they are applied.
# AUTO_MIGRATE=false

# 4 to 31, or FAST (10), NORMAL (12), STRONG (14).
# BCRYPT_COST=12

# 1m to 24h, or SHORT (10m), NORMAL (30m), LONG (1h).
# ACCESS_TOKEN_TTL=30m

# A duration, or SHORT (24h), NORMAL (168h), LONG (720h). There is no day unit.
# REFRESH_TOKEN_TTL=168h

# json or text.
# LOG_FORMAT=json

# off, relaxed, normal or strict. off is deprecated.
# RATE_LIMIT=off

# Comma-separated IP addresses and CIDR prefixes, such as 10.0.0.0/8, 192.0.2.10.
# Empty means none.
# TRUSTED_PROXIES=

# 32 random bytes in base64: openssl rand -base64 32. Empty means unset, which is
# deprecated. Read docs/configuration.md first: it cannot be changed in place.
# SIGNING_KEY_ENCRYPTION_KEY=

# off, or a duration of at least 1h.
# SESSION_RETENTION=720h
